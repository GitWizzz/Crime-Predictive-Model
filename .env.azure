# Deployment Configuration for Azure VM
# IP: 20.214.138.101

# Postgres settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_azure_password_123 # Change this to a secure password
POSTGRES_DB=crime_hotspot_db

# Backend database connection string (use the same credentials as above)
DATABASE_URL=postgresql://postgres:secure_azure_password_123@db:5432/crime_hotspot_db

# Backend Security
JWT_SECRET=super_secure_jwt_secret_for_azure # Change this
JWT_EXPIRES_IN=7d

# CORS configuration - allow the public frontend IP
CORS_ORIGIN=http://20.214.138.101:3000

# Backend ML Service Connection (Internal docker network)
ML_SERVICE_URL=http://ml-service:8001

# Frontend API Connection - point to the public IP of the backend
NEXT_PUBLIC_API_BASE=http://20.214.138.101:4000
